    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const title = $json.title;\nconst link = $json.link;\nconst content = $json.content;\nconst website_tag =$json.website_tag\n\nconst date = new Date($json.date).toLocaleString(\"en-GB\", {\n  day: \"2-digit\",\n  month: \"short\",\n  year: \"numeric\",\n  hour: \"2-digit\",\n  minute: \"2-digit\"\n});\n\nlet priority = \"⚪ Low\";\n\nconst text = title.toLowerCase();\n\nif (\n  text.includes(\"zero-day\") ||\n  text.includes(\"ransomware\") ||\n  text.includes(\"active exploit\") ||\n  text.includes(\"critical\") ||\n  text.includes(\"rce\")\n) {\n  priority = \"🔴 Critical\";\n}\nelse if (\n  text.includes(\"cve\") ||\n  text.includes(\"vulnerability\") ||\n  text.includes(\"patch\") ||\n  text.includes(\"exploit\")\n) {\n  priority = \"🟠 High\";\n}\nelse if (\n  text.includes(\"security\") ||\n  text.includes(\"research\")\n) {\n  priority = \"🟡 Medium\";\n}\n\nconst shortContent =\n  content.length > 450\n    ? content.substring(0, 450) + \"...\"\n    : content;\n\nconst message = `\n\n${priority }\n\n📌 ${title}\n\n${date}\n${website_tag}\n\n📄 Description:\n${shortContent}\n\n🔗 Read more:\n${link}\n`;\n\nreturn {\n  json: {\n    message\n  }\n};"
      },
